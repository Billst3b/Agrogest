<%-- Sidebar do admin. Antes do include: <c:set var="ativo" value="produtos"/> --%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<aside class="sidebar">
    <a class="marca" href="${ctx}/admin/dashboard"><span class="logo"><span class="i i-folha"></span></span> AgroGest</a>
    <a class="item ${ativo == 'dashboard' ? 'ativo' : ''}" href="${ctx}/admin/dashboard"><span class="i i-painel"></span> Dashboard</a>
    <a class="item ${ativo == 'clientes' ? 'ativo' : ''}" href="${ctx}/admin/clientes"><span class="i i-pessoas"></span> Clientes</a>
    <a class="item ${ativo == 'fornecedores' ? 'ativo' : ''}" href="${ctx}/admin/fornecedores"><span class="i i-camiao"></span> Fornecedores</a>
    <a class="item ${ativo == 'produtos' ? 'ativo' : ''}" href="${ctx}/admin/produtos"><span class="i i-caixa"></span> Produtos</a>
    <a class="item ${ativo == 'campanhas' ? 'ativo' : ''}" href="${ctx}/admin/campanhas"><span class="i i-calendario"></span> Campanhas</a>
    <a class="item ${ativo == 'cultivos' ? 'ativo' : ''}" href="${ctx}/admin/cultivos"><span class="i i-rebento"></span> Cultivos</a>
    <a class="item ${ativo == 'colheitas' ? 'ativo' : ''}" href="${ctx}/admin/colheitas"><span class="i i-cesto"></span> Colheitas</a>
    <a class="item ${ativo == 'vendas' ? 'ativo' : ''}" href="${ctx}/admin/vendas"><span class="i i-recibo"></span> Vendas</a>
    <a class="item ${ativo == 'relatorios' ? 'ativo' : ''}" href="${ctx}/admin/relatorios"><span class="i i-grafico"></span> Relatórios</a>
    <div class="rodape">
        <div class="quem">Sessão: <c:out value="${sessionScope.nome}"/></div>
        <a class="item" href="${ctx}/logout"><span class="i i-sair"></span> Sair</a>
    </div>
</aside>
