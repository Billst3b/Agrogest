<%@ page pageEncoding="UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<aside class="sidebar">
    <a class="marca" href="${ctx}/admin/dashboard" title="AgroGest — Sistema de Gestão Agrícola">
        <img src="${ctx}/img/logo-crest.png" alt="AgroGest" class="logo-img">
        <span class="marca-bloco">
            <span class="marca-texto">Agro<span class="destaque">Gest</span></span>
            <span class="marca-sub">SISTEMA DE GESTÃO AGRÍCOLA</span>
        </span>
    </a>
    <a class="item ${ativo == 'dashboard' ? 'ativo' : ''}" href="${ctx}/admin/dashboard"><span class="i i-painel"></span> Dashboard</a>
    <a class="item ${ativo == 'produtos' ? 'ativo' : ''}" href="${ctx}/admin/produtos"><span class="i i-caixa"></span> Produtos</a>
    <a class="item ${ativo == 'fornecedores' ? 'ativo' : ''}" href="${ctx}/admin/fornecedores"><span class="i i-camiao"></span> Fornecedores</a>
    <a class="item ${ativo == 'campanhas' ? 'ativo' : ''}" href="${ctx}/admin/campanhas"><span class="i i-calendario"></span> Campanhas</a>
    <a class="item ${ativo == 'cultivos' ? 'ativo' : ''}" href="${ctx}/admin/cultivos"><span class="i i-rebento"></span> Cultivos</a>
    <a class="item ${ativo == 'colheitas' ? 'ativo' : ''}" href="${ctx}/admin/colheitas"><span class="i i-cesto"></span> Colheitas</a>
    <a class="item ${ativo == 'vendas' ? 'ativo' : ''}" href="${ctx}/admin/vendas"><span class="i i-recibo"></span> Vendas</a>
    <a class="item ${ativo == 'clientes' ? 'ativo' : ''}" href="${ctx}/admin/clientes"><span class="i i-pessoas"></span> Clientes</a>
    <a class="item ${ativo == 'relatorios' ? 'ativo' : ''}" href="${ctx}/admin/relatorios"><span class="i i-grafico"></span> Relatórios</a>
    <div class="rodape">
        <div class="tema-seletor" role="group" aria-label="Ambiente de cor de fundo">
            <span class="tema-rotulo">Ambiente</span>
            <div class="tema-bolhas">
                <button type="button" class="tema-bolha t-bronze" data-tema-opcao="bronze" title="Terra Bronze (Padrão)" aria-label="Tema Terra Bronze"></button>
                <button type="button" class="tema-bolha t-floresta" data-tema-opcao="floresta" title="Floresta Esmeralda" aria-label="Tema Floresta Esmeralda"></button>
                <button type="button" class="tema-bolha t-oceano" data-tema-opcao="oceano" title="Oceano Índico" aria-label="Tema Oceano Índico"></button>
                <button type="button" class="tema-bolha t-savana" data-tema-opcao="savana" title="Savana Dourada" aria-label="Tema Savana Dourada"></button>
                <button type="button" class="tema-bolha t-ametista" data-tema-opcao="ametista" title="Crepúsculo Ametista" aria-label="Tema Crepúsculo Ametista"></button>
                <button type="button" class="tema-bolha t-obsidiana" data-tema-opcao="obsidiana" title="Obsidiana Carbono" aria-label="Tema Obsidiana Carbono"></button>
            </div>
        </div>
        <div class="quem"><c:out value="${sessionScope.nome}"/></div>
        <a class="item" href="${ctx}/logout"><span class="i i-sair"></span> Terminar Sessão</a>
    </div>
</aside>
