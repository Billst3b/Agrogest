<%@ page pageEncoding="UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<header class="topbar">
    <div class="inner">
        <a class="marca" href="${ctx}/catalogo"><span class="logo"><span class="i i-folha"></span></span> AgroGest</a>
        <nav>
            <span class="ola">Olá, <strong><c:out value="${sessionScope.nome}"/></strong></span>
            <a class="${ativo == 'catalogo' ? 'ativo' : ''}" href="${ctx}/catalogo"><span class="i i-caixa"></span> Catálogo</a>
            <a class="${ativo == 'carrinho' ? 'ativo' : ''}" href="${ctx}/carrinho"><span class="i i-carrinho"></span> Carrinho<c:if test="${not empty sessionScope.carrinho}"> <span class="badge aberta">${sessionScope.carrinho.size()}</span></c:if></a>
            <a class="${ativo == 'compras' ? 'ativo' : ''}" href="${ctx}/minhas-compras"><span class="i i-recibo"></span> Minhas Compras</a>
            <a href="${ctx}/logout"><span class="i i-sair"></span> Sair</a>
        </nav>
    </div>
</header>
